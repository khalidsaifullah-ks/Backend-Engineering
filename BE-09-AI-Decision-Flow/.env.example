# OpenAI-compatible key. Groq's OpenAI-compatible endpoint also works here.
OPENAI_API_KEY=sk-...
# Only needed if you use Groq (or another OpenAI-compatible provider) instead of OpenAI.
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.1-8b-instant

# Inngest (leave blank for local dev with `npx inngest-cli dev`)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# URL of the Inngest Dev Server's REST API (used to poll for run results)
INNGEST_DEV_URL=http://localhost:8299
